# TEST stack only. Copy to .env and replace every placeholder with unique values.
# Never use these placeholders or TEST secrets for REAL data.
DB_PASSWORD=replace-with-a-long-random-test-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-test-root-password
APP_KEY=base64:replace-with-a-generated-32-byte-test-only-key
SSO_EMAIL=test@example.invalid
AUTHELIA_SESSION_SECRET=replace-with-at-least-64-random-characters
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace-with-a-different-64-character-random-key
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=replace-with-a-third-64-character-random-key

# Keep "web" through first-user bootstrap; switch to remote_user_guard only
# after registering SSO_EMAIL in Firefly and creating the importer PAT.
AUTHENTICATION_GUARD=web
FIREFLY_III_ACCESS_TOKEN=
